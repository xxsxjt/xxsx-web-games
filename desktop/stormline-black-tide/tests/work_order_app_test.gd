extends "res://tests/expedition_app_test.gd"
## Actual buttons, original State/Store, isolated profiles; no campaign injection.

func _run() -> void:
	if DisplayServer.get_name() != "headless":
		quit(1)
		return
	_folder = ProjectSettings.globalize_path("res://.testdata/work-order-%d-%d" % [OS.get_process_id(), Time.get_ticks_usec()])
	_check(DirAccess.make_dir_recursive_absolute(_folder) == OK, "isolated fixtures")
	_records = _folder.path_join("best.json")
	var records := Records.new(_records)
	for id: String in Sim.CONTRACTS:
		for score: int in [9800, 10000]:
			_check(records.record(id, {"score": score, "time": 2.0, "grade": "S", "hull": 100.0, "peak_tension": 0.0}) == Records.NEW_BEST, "seed isolated scores")
	_original_records = _record_bytes()
	var path := _folder.path_join("order.json")
	var app := _open(path)
	Keys.edge(app.get_viewport(), KEY_X)
	_press(app, "new")
	var opening := _saved(path).duplicate(true)
	_press(app, "tab_work_order")
	await _geometry(app, "empty work order")
	for id: String in ["queue_buy_drive", "queue_equip_drive", "queue_buy_sonar", "queue_equip_sonar", "queue_prepare_kit"]:
		_press(app, id)
	_check(_saved(path) == opening and _state(app) == opening and app.get("_work_order").size() == 5, "five real buttons change memory only")
	_check(_button(app, "launch").disabled and _texts(_desk(app)).contains("资金 180 → 36"), "draft blocks launch and shows actual combined cost")
	await _geometry(app, "combined outfitting preview")
	_press(app, "undo_work_order")
	_check(app.get("_work_order").size() == 4 and _saved(path) == opening, "undo without spending")
	_press(app, "queue_prepare_kit")
	_press(app, "commit_work_order")
	await _geometry(app, "order confirmation")
	Keys.edge(app.get_viewport(), KEY_ESCAPE)
	_check(_saved(path) == opening and app.get("_work_order").size() == 5, "cancel retains unpaid draft")
	_press(app, "desk")
	_check(app.get("_confirmation") == "discard_work_order", "navigation asks before discarding")
	_press(app, "cancel")
	var expected: Dictionary = State.preview_work_order(opening, app.get("_work_order")).state
	_block_backup(path)
	_press(app, "commit_work_order")
	_press(app, "confirm")
	_check(_saved(path) == opening and _state(app) == opening and app.get("_work_order").size() == 5 and _notice(app).contains("保存失败"), "blocked Store has no partial order")
	_unblock_backup(path)
	_press(app, "commit_work_order")
	_press(app, "confirm")
	_check(_saved(path) == expected and _state(app) == expected and expected.revision == opening.revision + 1, "single save uses exact preview")
	_check(expected.history.size() == 5 and app.get("_work_order").is_empty(), "events retained; committed draft cleared")
	var saved_bytes := FileAccess.get_file_as_bytes(path)
	app.call("_on_expedition_action", "confirm", "")
	_check(FileAccess.get_file_as_bytes(path) == saved_bytes, "repeated confirmation cannot duplicate expenses")
	_press(app, "queue_prepare_kit")
	_press(app, "clear_work_order")
	_check(_saved(path) == expected and app.get("_work_order").is_empty(), "clear changes no archive")
	await _close(app)
	app = _open(path)
	Keys.edge(app.get_viewport(), KEY_X)
	_press(app, "continue")
	_check(_state(app) == expected and app.get("_work_order").is_empty(), "fresh main reads committed state only")
	_press(app, "tab_work_order")
	_press(app, "queue_prepare_kit")
	var remote := State.act(_saved(path), "prepare_kit")
	_check(Store.new(path).save_state(remote.state, int(expected.revision)).ok, "independent Store advances disk")
	_press(app, "commit_work_order")
	_press(app, "confirm")
	_check(_saved(path) == remote.state and _state(app) == expected and app.get("_expedition_conflict"), "stale order cannot overwrite disk")
	_press(app, "reload")
	_press(app, "continue")
	_check(_state(app) == remote.state and app.get("_work_order").is_empty(), "explicit reload discards stale draft")
	if _launch(app, path, "black-tide-survey-safe"):
		var view: Dictionary = app.get("sim").snapshot()
		_check(view.expedition.loadout == ["drive", "sonar"] and view.damage_control.kits == 2 and view.battery == remote.state.battery, "paid launch uses actually saved work-order configuration")
		var metrics := await _sail(app, true, false)
		_check(_delivery(app, metrics, "work-order first deployment") and _saved(path) == _state(app), "real ordered-config voyage delivers and persists")
		_press(app, "dock")
		var returned := _saved(path).duplicate(true)
		var selected: Dictionary = State.offers(returned)[0]
		_press(app, "tab_work_order")
		_press(app, "queue_recharge")
		_press(app, "queue_unload_kit")
		var projection: Dictionary = State.preview_work_order(returned, app.get("_work_order")).state
		var changed_offer: Dictionary = Catalog.build_contract(selected.id, int(projection.pressure), projection.path)
		_check(_saved(path) == returned and projection.battery == 100 and projection.pressure == returned.pressure + 1,
			"cross-voyage actual remaining battery is recharged only in draft")
		_check(_texts(_desk(app)).contains("海况 %.3f → %.3f" % [float(selected.severity), float(changed_offer.severity)])
			and _texts(_desk(app)).contains("窗口 %.0f → %.0f" % [float(selected.deadline), float(changed_offer.deadline)]), "real pressure changes selected next-contract preview")
		await _geometry(app, "cross-voyage recharge and contract-pressure comparison")
		_press(app, "commit_work_order")
		_press(app, "confirm")
		_check(_saved(path) == projection and projection.path == returned.path and projection.campaign_id == returned.campaign_id,
			"cross-voyage order preserves path and campaign identity")
	await _close(app)
	# Explicit new old-format fixture, not a real player archive or migration.
	var old_path := _folder.path_join("old.json")
	var old := State.new_campaign()
	_check(Store.new(old_path).save_state(old, -1).ok, "create isolated original-v1 compatibility fixture")
	app = _open(old_path)
	Keys.edge(app.get_viewport(), KEY_X)
	_press(app, "continue")
	_press(app, "tab_work_order")
	_check(_button(app, "queue_prepare_kit").disabled, "old format does not gain damage controls")
	_press(app, "queue_buy_sonar")
	_press(app, "queue_equip_sonar")
	_press(app, "commit_work_order")
	_press(app, "confirm")
	_check(not _saved(old_path).has("damage_control") and _saved(old_path).campaign_id == old.campaign_id
		and _saved(old_path).revision == 1, "old v1 single-revision order retains original identity and shape")
	await _close(app)
	_check(_record_bytes() == _original_records and Keys.all_released(), "all score bytes unchanged, keys released")
	_clean_fixtures()
	print("Stormline work order app: %d checks, %d failures; native buttons and one model-input delivery, NOT human play." % [_checks, _failures])
	quit(0 if _failures == 0 else 1)
